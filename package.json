{
  "name": "root",
  "private": true,
  "scripts": {
    "g:prettier": "cd $INIT_CWD && prettier",
    "g:eslint": "cd $INIT_CWD && eslint",
    "g:tsdown": "cd $INIT_CWD && tsdown --config ../../tsdown.config.mts",
    "g:jest": "cd $INIT_CWD && jest",
    "g:copy-readme": "ncp README.md $INIT_CWD/README.md",
    "format-all": "yarn workspaces foreach -A run format",
    "lint-all": "yarn workspaces foreach -A run lint",
    "build-all": "yarn workspaces foreach -Ap --topological-dev run build",
    "check:exports": "yarn workspaces foreach -A --exclude root exec node ../../scripts/check-exports.mjs",
    "test-all": "jest --coverage",
    "test:bundle": "node --test test/bundle/*.test.mjs && node test/bundle/check.mjs && node test/bundle/workspaces.mjs",
    "test-sonarqube": "yarn workspaces foreach -A run test",
    "release": "yarn build-all && release-it",
    "u": "yarn upgrade-interactive && yarn dedupe"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@release-it-plugins/workspaces": "^6.0.0",
    "@release-it/conventional-changelog": "12.0.2",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "dpdm": "^4.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-standard": "^5.0.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "ncp": "^2.0.0",
    "prettier": "^3.9.10",
    "release-it": "19.2.4",
    "ts-jest": "^29.4.15",
    "tsdown": "0.23.5",
    "typescript": "~6.0.3"
  },
  "packageManager": "yarn@4.6.0",
  "dependencies": {
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0"
  }
}
