{
  "name": "@thisisagile/easy-test-react",
  "version": "0.1.0",
  "description": "Straightforward wrapper library for testing-library/react",
  "author": "Sander Hoogendoorn",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git@github.com:thisisagile/easy.git"
  },
  "keywords": [
    "typescript",
    "microservices",
    "domain-driven-design",
    "evolutionary-architecture",
    "jest",
    "unit testing"
  ],
  "scripts": {
    "lint": "yarn g:eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "yarn g:prettier --check --write src test *.json",
    "build": "yarn g:tsdown && yarn g:exports",
    "test": "yarn g:jest --coverage",
    "prepack": "yarn g:copy-readme"
  },
  "sideEffects": [
    "./dist/index.js",
    "./src/index.ts"
  ],
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@thisisagile/easy-test": "workspace:*",
    "jest-environment-jsdom": "^29.7.0",
    "weak-napi": "^2.0.2"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@thisisagile/easy": "workspace:^",
    "@types/react": "^18.3.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ElementTester": {
      "types": "./dist/ElementTester.d.ts",
      "default": "./dist/ElementTester.js"
    },
    "./Tester": {
      "types": "./dist/Tester.d.ts",
      "default": "./dist/Tester.js"
    },
    "./waitForRender": {
      "types": "./dist/waitForRender.d.ts",
      "default": "./dist/waitForRender.js"
    },
    "./src/*": "./src/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  }
}
