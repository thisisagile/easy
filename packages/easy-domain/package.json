{
  "name": "@thisisagile/easy-domain",
  "version": "0.1.0",
  "description": "Common domain objects for easy microservices",
  "author": "Sander Hoogendoorn",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git@github.com:thisisagile/easy.git"
  },
  "keywords": [
    "typescript",
    "microservices",
    "domain-driven-design",
    "evolutionary-architecture"
  ],
  "scripts": {
    "lint": "yarn g:eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "yarn g:prettier --check --write src test *.json",
    "build": "yarn g:tsdown",
    "test": "yarn g:jest --coverage",
    "prepack": "yarn g:copy-readme"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@thisisagile/easy-test": "workspace:*",
    "@types/validator": "^13.12.2"
  },
  "dependencies": {
    "@thisisagile/easy": "workspace:^",
    "validator": "^13.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Country": {
      "types": "./dist/entries/Country.d.ts",
      "default": "./dist/entries/Country.js"
    },
    "./Currency": {
      "types": "./dist/entries/Currency.d.ts",
      "default": "./dist/entries/Currency.js"
    },
    "./Locale": {
      "types": "./dist/entries/Locale.d.ts",
      "default": "./dist/entries/Locale.js"
    },
    "./UnitOfMeasurement": {
      "types": "./dist/entries/UnitOfMeasurement.d.ts",
      "default": "./dist/entries/UnitOfMeasurement.js"
    },
    "./UnitOfWeight": {
      "types": "./dist/entries/UnitOfWeight.d.ts",
      "default": "./dist/entries/UnitOfWeight.js"
    },
    "./structs/Address": {
      "types": "./dist/structs/Address.d.ts",
      "default": "./dist/structs/Address.js"
    },
    "./structs/Box": {
      "types": "./dist/structs/Box.d.ts",
      "default": "./dist/structs/Box.js"
    },
    "./structs/Dimension": {
      "types": "./dist/structs/Dimension.d.ts",
      "default": "./dist/structs/Dimension.js"
    },
    "./structs/Money": {
      "types": "./dist/structs/Money.d.ts",
      "default": "./dist/structs/Money.js"
    },
    "./structs/Name": {
      "types": "./dist/structs/Name.d.ts",
      "default": "./dist/structs/Name.js"
    },
    "./structs/Weight": {
      "types": "./dist/structs/Weight.d.ts",
      "default": "./dist/structs/Weight.js"
    },
    "./utils/defaultExport": {
      "types": "./dist/utils/defaultExport.d.ts",
      "default": "./dist/utils/defaultExport.js"
    },
    "./values/DunsNumber": {
      "types": "./dist/values/DunsNumber.d.ts",
      "default": "./dist/values/DunsNumber.js"
    },
    "./values/EAN": {
      "types": "./dist/values/EAN.d.ts",
      "default": "./dist/values/EAN.js"
    },
    "./values/Email": {
      "types": "./dist/values/Email.d.ts",
      "default": "./dist/values/Email.js"
    },
    "./values/IBAN": {
      "types": "./dist/values/IBAN.d.ts",
      "default": "./dist/values/IBAN.js"
    },
    "./values/PostalCode": {
      "types": "./dist/values/PostalCode.d.ts",
      "default": "./dist/values/PostalCode.js"
    },
    "./values/Slug": {
      "types": "./dist/values/Slug.d.ts",
      "default": "./dist/values/Slug.js"
    },
    "./values/Url": {
      "types": "./dist/values/Url.d.ts",
      "default": "./dist/values/Url.js"
    },
    "./values/VAT": {
      "types": "./dist/values/VAT.d.ts",
      "default": "./dist/values/VAT.js"
    },
    "./src/*": "./src/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  }
}
