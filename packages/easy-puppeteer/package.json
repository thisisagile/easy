{
  "name": "@thisisagile/easy-puppeteer",
  "version": "0.1.0",
  "description": "Straightforward wrapper library for Puppeteer web testing framework",
  "author": "Sander Hoogendoorn",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git@github.com:thisisagile/easy.git"
  },
  "keywords": [
    "typescript",
    "microservices",
    "domain-driven-design",
    "evolutionary-architecture",
    "jest",
    "unit testing",
    "web testing"
  ],
  "scripts": {
    "lint": "yarn g:eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "yarn g:prettier --check --write src test *.json",
    "build": "yarn g:tsdown && yarn g:exports",
    "test": "yarn g:jest --coverage",
    "prepack": "yarn g:copy-readme"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@thisisagile/easy-test": "workspace:*"
  },
  "dependencies": {
    "@thisisagile/easy": "workspace:^",
    "@thisisagile/easy-test-web": "workspace:^",
    "puppeteer": "^24.43.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./PuppeteerElement": {
      "types": "./dist/PuppeteerElement.d.ts",
      "default": "./dist/PuppeteerElement.js"
    },
    "./PuppeteerTester": {
      "types": "./dist/PuppeteerTester.d.ts",
      "default": "./dist/PuppeteerTester.js"
    },
    "./src/*": "./src/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  }
}
