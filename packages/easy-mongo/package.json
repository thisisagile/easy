{
  "name": "@thisisagile/easy-mongo",
  "version": "0.1.0",
  "description": "Add support for MongoDB",
  "author": "Sander Hoogendoorn",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git@github.com:thisisagile/easy.git"
  },
  "keywords": [
    "typescript",
    "microservices",
    "domain-driven-design",
    "evolutionary-architecture"
  ],
  "scripts": {
    "lint": "yarn g:eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "yarn g:prettier --check --write src test *.json",
    "build": "yarn g:tsdown && yarn g:exports",
    "test": "yarn g:jest --coverage",
    "prepack": "yarn g:copy-readme"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@thisisagile/easy-test": "workspace:*"
  },
  "dependencies": {
    "@thisisagile/easy": "workspace:^",
    "mongodb": "^6.17.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./AtlasSearchGateway": {
      "types": "./dist/AtlasSearchGateway.d.ts",
      "default": "./dist/AtlasSearchGateway.js"
    },
    "./Collection": {
      "types": "./dist/Collection.d.ts",
      "default": "./dist/Collection.js"
    },
    "./Lucene": {
      "types": "./dist/Lucene.d.ts",
      "default": "./dist/Lucene.js"
    },
    "./MongoGateway": {
      "types": "./dist/MongoGateway.d.ts",
      "default": "./dist/MongoGateway.js"
    },
    "./MongoProvider": {
      "types": "./dist/MongoProvider.d.ts",
      "default": "./dist/MongoProvider.js"
    },
    "./Stages": {
      "types": "./dist/Stages.d.ts",
      "default": "./dist/Stages.js"
    },
    "./Utils": {
      "types": "./dist/Utils.d.ts",
      "default": "./dist/Utils.js"
    },
    "./src/*": "./src/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  }
}
