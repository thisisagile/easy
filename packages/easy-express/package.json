{
  "name": "@thisisagile/easy-express",
  "version": "0.1.0",
  "description": "Straightforward library for building domain-driven microservice architectures",
  "author": "Sander Hoogendoorn",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git@github.com:thisisagile/easy.git"
  },
  "keywords": [
    "typescript",
    "microservices",
    "domain-driven-design",
    "evolutionary-architecture"
  ],
  "scripts": {
    "lint": "yarn g:eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "yarn g:prettier --check --write src test *.json",
    "build": "yarn g:tsdown && yarn g:exports",
    "test": "yarn g:jest --coverage",
    "prepack": "yarn g:copy-readme"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@thisisagile/easy-test": "workspace:*",
    "@types/cls-hooked": "^4.3.9",
    "@types/form-urlencoded": "^4.4.2",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^9.0.8",
    "@types/validator": "^13.12.2"
  },
  "dependencies": {
    "@thisisagile/easy": "workspace:^",
    "@thisisagile/easy-service": "workspace:^",
    "@types/express": "^4.17.25",
    "cls-hooked": "^4.2.2",
    "express": "^4.22.3",
    "form-urlencoded": "^6.1.5",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express/AuthError": {
      "types": "./dist/express/AuthError.d.ts",
      "default": "./dist/express/AuthError.js"
    },
    "./express/CorrelationHandler": {
      "types": "./dist/express/CorrelationHandler.d.ts",
      "default": "./dist/express/CorrelationHandler.js"
    },
    "./express/ErrorHandler": {
      "types": "./dist/express/ErrorHandler.d.ts",
      "default": "./dist/express/ErrorHandler.js"
    },
    "./express/ExpressProvider": {
      "types": "./dist/express/ExpressProvider.d.ts",
      "default": "./dist/express/ExpressProvider.js"
    },
    "./express/NotFoundHandler": {
      "types": "./dist/express/NotFoundHandler.d.ts",
      "default": "./dist/express/NotFoundHandler.js"
    },
    "./express/RequestContextHandler": {
      "types": "./dist/express/RequestContextHandler.d.ts",
      "default": "./dist/express/RequestContextHandler.js"
    },
    "./express/SecurityHandler": {
      "types": "./dist/express/SecurityHandler.d.ts",
      "default": "./dist/express/SecurityHandler.js"
    },
    "./express/index": {
      "types": "./dist/express/index.d.ts",
      "default": "./dist/express/index.js"
    },
    "./types/NamespaceContext": {
      "types": "./dist/types/NamespaceContext.d.ts",
      "default": "./dist/types/NamespaceContext.js"
    },
    "./types/index": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./src/*": "./src/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  }
}
