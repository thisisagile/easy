{
  "name": "@thisisagile/easy-service",
  "version": "0.1.0",
  "description": "Straightforward library for building domain-driven microservice architectures",
  "author": "Sander Hoogendoorn",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git@github.com:thisisagile/easy.git"
  },
  "keywords": [
    "typescript",
    "microservices",
    "domain-driven-design",
    "evolutionary-architecture"
  ],
  "scripts": {
    "lint": "yarn g:eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "yarn g:prettier --check --write src test *.json",
    "build": "yarn g:tsdown",
    "test": "yarn g:jest --coverage",
    "prepack": "yarn g:copy-readme"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@thisisagile/easy-test": "workspace:*"
  },
  "dependencies": {
    "@thisisagile/easy": "workspace:^",
    "jsonwebtoken": "^9.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./health/HealthResource": {
      "types": "./dist/health/HealthResource.d.ts",
      "default": "./dist/health/HealthResource.js"
    },
    "./health/HealthUri": {
      "types": "./dist/health/HealthUri.d.ts",
      "default": "./dist/health/HealthUri.js"
    },
    "./http/OriginatedError": {
      "types": "./dist/http/OriginatedError.d.ts",
      "default": "./dist/http/OriginatedError.js"
    },
    "./http/Verb": {
      "types": "./dist/http/Verb.d.ts",
      "default": "./dist/http/Verb.js"
    },
    "./resources/AppProvider": {
      "types": "./dist/resources/AppProvider.d.ts",
      "default": "./dist/resources/AppProvider.js"
    },
    "./resources/Requires": {
      "types": "./dist/resources/Requires.d.ts",
      "default": "./dist/resources/Requires.js"
    },
    "./resources/Resource": {
      "types": "./dist/resources/Resource.d.ts",
      "default": "./dist/resources/Resource.js"
    },
    "./resources/Route": {
      "types": "./dist/resources/Route.d.ts",
      "default": "./dist/resources/Route.js"
    },
    "./resources/Service": {
      "types": "./dist/resources/Service.d.ts",
      "default": "./dist/resources/Service.js"
    },
    "./security/Jwt": {
      "types": "./dist/security/Jwt.d.ts",
      "default": "./dist/security/Jwt.js"
    },
    "./src/*": "./src/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  }
}
